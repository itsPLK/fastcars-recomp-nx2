diff --git a/include/rex/filesystem/devices/stfs_xbox.h b/include/rex/filesystem/devices/stfs_xbox.h
index 7d4e3663..7e23a480 100644
--- a/include/rex/filesystem/devices/stfs_xbox.h
+++ b/include/rex/filesystem/devices/stfs_xbox.h
@@ -42,6 +42,19 @@ inline uint64_t decode_fat_timestamp(const uint32_t date, const uint32_t time) {
 
 #if REX_PLATFORM_WIN32
   time_t timet = _mkgmtime(&tm);
+#elif REX_PLATFORM_SWITCH2
+  // newlib has no timegm: days from the civil date (H. Hinnant's days_from_civil), all UTC.
+  if (tm.tm_mon < 0 || tm.tm_mon > 11) {
+    return 0;
+  }
+  const int64_t y = int64_t(tm.tm_year) + 1900 - (tm.tm_mon < 2 ? 1 : 0);
+  const int64_t era = (y >= 0 ? y : y - 399) / 400;
+  const int64_t yoe = y - era * 400;
+  const int64_t mp = (tm.tm_mon + 10) % 12;  // March = 0
+  const int64_t doy = (153 * mp + 2) / 5 + tm.tm_mday - 1;
+  const int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  const int64_t days = era * 146097 + doe - 719468;
+  time_t timet = time_t(days * 86400 + tm.tm_hour * 3600 + tm.tm_min * 60 + tm.tm_sec);
 #else
   time_t timet = timegm(&tm);
 #endif
