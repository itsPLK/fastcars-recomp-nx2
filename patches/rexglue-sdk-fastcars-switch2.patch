new file mode 100644
index 00000000..e52c46e4
--- /dev/null
+++ b/src/core/dynlib_switch2.cpp
@@ -0,0 +1,113 @@
+// Switch 2: no dynamic loader. DynamicLibrary opens built-in libraries from a registry instead
+// (see RegisterBuiltinLibrary in rex/platform/dynlib.h).
+#include <rex/platform.h>
+#include <rex/platform/dynlib.h>
+
+static_assert(REX_PLATFORM_SWITCH2, "Switch 2 only");
+
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+// OunceVK links statically. Executables link the copy made by switch2/support
+// (rex_switch2_vulkan), whose only global Vulkan symbol is this renamed vkGetInstanceProcAddr:
+// volk (plume) owns the vk* names in the same executable. The instance argument is a dispatchable
+// handle (a pointer), so void* is ABI-compatible with VkInstance.
+extern "C" void* rex_ounce_vkGetInstanceProcAddr(void* instance, const char* name);
+
+namespace rex::platform {
+
+namespace {
+
+struct BuiltinLibrary {
+  std::string name;
+  BuiltinSymbolResolver resolver;
+};
+
+// A desktop loader exports instance-level commands as symbols; vkGetInstanceProcAddr(NULL, ...)
+// returns them as null (Vulkan spec). The SDK takes vkDestroyInstance from the "library" before it
+// has an instance, so it gets a trampoline that looks the command up on the instance it is given.
+using DestroyInstanceFn = void (*)(void* instance, const void* allocator);
+void DestroyInstanceTrampoline(void* instance, const void* allocator) {
+  auto fn = reinterpret_cast<DestroyInstanceFn>(
+      rex_ounce_vkGetInstanceProcAddr(instance, "vkDestroyInstance"));
+  if (fn) fn(instance, allocator);
+}
+
+void* ResolveVulkan(const char* name) {
+  if (std::strcmp(name, "vkGetInstanceProcAddr") == 0) {
+    return reinterpret_cast<void*>(&rex_ounce_vkGetInstanceProcAddr);
+  }
+  if (std::strcmp(name, "vkDestroyInstance") == 0) {
+    return reinterpret_cast<void*>(&DestroyInstanceTrampoline);
+  }
+  return rex_ounce_vkGetInstanceProcAddr(nullptr, name);
+}
+
+std::mutex& RegistryMutex() {
+  static std::mutex mutex;
+  return mutex;
+}
+
+std::vector<BuiltinLibrary>& Registry() {
+  static std::vector<BuiltinLibrary> registry{{lib_names::kVulkanLoader, &ResolveVulkan}};
+  return registry;
+}
+
+}  // namespace
+
+void RegisterBuiltinLibrary(const char* name, BuiltinSymbolResolver resolver) {
+  std::lock_guard lock(RegistryMutex());
+  for (BuiltinLibrary& library : Registry()) {
+    if (library.name == name) {
+      library.resolver = resolver;
+      return;
+    }
+  }
+  Registry().push_back({name, resolver});
+}
+
+DynamicLibrary::~DynamicLibrary() {
+  Close();
+}
+
+DynamicLibrary::DynamicLibrary(DynamicLibrary&& other) noexcept : handle_(other.handle_) {
+  other.handle_ = nullptr;
+}
+
+DynamicLibrary& DynamicLibrary::operator=(DynamicLibrary&& other) noexcept {
+  if (this != &other) {
+    Close();
+    handle_ = other.handle_;
+    other.handle_ = nullptr;
+  }
+  return *this;
+}
+
+bool DynamicLibrary::Load(const std::filesystem::path& path, SymbolResolution /*mode*/) {
+  Close();
+  const std::string name = path.stem().string();
+  std::lock_guard lock(RegistryMutex());
+  for (BuiltinLibrary& library : Registry()) {
+    if (library.name == name) {
+      // The registry never shrinks, so the entry's address stays valid.
+      handle_ = &library;
+      return true;
+    }
+  }
+  return false;
+}
+
+void DynamicLibrary::Close() {
+  handle_ = nullptr;
+}
+
+void* DynamicLibrary::GetRawSymbol(const char* name) const {
+  if (!handle_) {
+    return nullptr;
+  }
+  return static_cast<const BuiltinLibrary*>(handle_)->resolver(name);
+}
+
+}  // namespace rex::platform
