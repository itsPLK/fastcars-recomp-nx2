diff --git a/include/rex/platform/exception_switch2.h b/include/rex/platform/exception_switch2.h
new file mode 100644
index 00000000..e0fd97e6
--- /dev/null
+++ b/include/rex/platform/exception_switch2.h
@@ -0,0 +1,44 @@
+/**
+ * Switch 2: resuming a thread from a CPU exception.
+ *
+ * libounce calls __libnx_exception_handler on the faulting thread, in normal user mode, on
+ * __nx_exception_stack (the kernel only restores x0-x8, lr, sp and pc on the way there, and
+ * libounce points sp/pc at its handler). Continuing the thread means restoring its full context
+ * ourselves: rex_switch2_resume restores every register from a ResumeFrame and branches to the
+ * frame's pc. It needs one scratch register for the branch: x16 (IP0) comes back holding pc,
+ * every other register as in the frame. That is safe when the thread resumes at a function
+ * entry (x16 is call-clobbered there), as the SEH throw trampoline does; resuming in the middle
+ * of a function loses x16.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_SWITCH2
+
+namespace rex::platform::switch2 {
+
+struct alignas(16) ResumeFrame {
+  uint64_t x[31];  // x0-x30 (x29 = fp, x30 = lr)
+  uint64_t sp;
+  uint64_t pc;
+  uint64_t nzcv;  // pstate condition flags
+  uint64_t fpsr;
+  uint64_t fpcr;
+  uint8_t v[32][16];
+};
+static_assert(offsetof(ResumeFrame, sp) == 248);
+static_assert(offsetof(ResumeFrame, pc) == 256);
+static_assert(offsetof(ResumeFrame, nzcv) == 264);
+static_assert(offsetof(ResumeFrame, fpsr) == 272);
+static_assert(offsetof(ResumeFrame, fpcr) == 280);
+static_assert(offsetof(ResumeFrame, v) == 288);
+
+}  // namespace rex::platform::switch2
+
+extern "C" [[noreturn]] void rex_switch2_resume(const rex::platform::switch2::ResumeFrame* frame);
+
+#endif  // REX_PLATFORM_SWITCH2
