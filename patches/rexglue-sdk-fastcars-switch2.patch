 namespace rex::thread {
 
+#if REX_PLATFORM_SWITCH2
+namespace {
+
+struct Switch2ThreadEntry {
+  Handle handle = INVALID_HANDLE;
+  u64 tid = 0;
+  std::string name;
+};
+
+class Switch2ThreadRegistry {
+ public:
+  static Switch2ThreadRegistry& Instance() {
+    static Switch2ThreadRegistry instance;
+    return instance;
+  }
+
+  void Register(Handle handle, u64 tid, const std::string& name) {
+    if (handle == INVALID_HANDLE || tid == 0) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto& entry : entries_) {
+      if (entry.tid == tid) {
+        entry.handle = handle;
+        if (!name.empty()) {
+          entry.name = name;
+        }
+        return;
+      }
+    }
+    entries_.push_back({handle, tid, name});
+  }
+
+  void UpdateName(u64 tid, const std::string& name) {
+    if (tid == 0) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    for (auto& entry : entries_) {
+      if (entry.tid == tid) {
+        entry.name = name;
+        return;
+      }
+    }
+  }
+
+  void Unregister(u64 tid) {
+    if (tid == 0) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    entries_.erase(std::remove_if(entries_.begin(), entries_.end(),
+                                  [tid](const Switch2ThreadEntry& e) { return e.tid == tid; }),
+                   entries_.end());
+  }
+
+  std::vector<Switch2ThreadEntry> Snapshot() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return entries_;
+  }
+
+ private:
+  std::mutex mutex_;
+  std::vector<Switch2ThreadEntry> entries_;
+};
+
+void Switch2SamplerLoop(int interval_ms) {
+  FILE* fp = std::fopen("logs/sampler.txt", "w");
+  if (!fp) {
+    return;
+  }
+  std::fprintf(fp, "rex_switch2_sampler_anchor=0x%llx interval_ms=%d\n",
+               static_cast<unsigned long long>(reinterpret_cast<uintptr_t>(&rex_switch2_sampler_anchor)),
+               interval_ms);
+  std::fflush(fp);
+  fsync(fileno(fp));
+
+  u64 self_tid = 0;
+  svcGetThreadId(&self_tid, CUR_THREAD_HANDLE);
+  const s64 interval_ns = static_cast<s64>(interval_ms) * 1000000LL;
+  uint64_t round = 0;
+
+  for (;;) {
+    auto threads = Switch2ThreadRegistry::Instance().Snapshot();
+    const u64 tick = armGetSystemTick();
+    std::fprintf(fp, "=== round %llu tick=%llu threads=%zu ===\n",
+                 static_cast<unsigned long long>(++round),
+                 static_cast<unsigned long long>(tick),
+                 threads.size());
+
+    for (const auto& t : threads) {
+      if (t.tid == self_tid || t.handle == INVALID_HANDLE) {
+        continue;
+      }
+      const bool paused_by_us = R_SUCCEEDED(svcSetThreadActivity(t.handle, ThreadActivity_Paused));
+      ThreadContext ctx{};
+      const Result ctx_rc = svcGetThreadContext3(&ctx, t.handle);
+
+      u64 bt[16];
+      int bt_count = 0;
+      if (R_SUCCEEDED(ctx_rc) && ctx.fp != 0 && (ctx.fp & 0x7ULL) == 0 && ctx.fp >= ctx.sp) {
+        MemoryInfo mem{};
+        u32 pageinfo = 0;
+        if (R_SUCCEEDED(svcQueryMemory(&mem, &pageinfo, ctx.sp)) &&
+            (mem.perm & Perm_R) == Perm_R) {
+          u64 fp_cur = ctx.fp;
+          while (bt_count < 16 && fp_cur != 0 && (fp_cur & 0x7ULL) == 0 &&
+                 fp_cur >= mem.addr && fp_cur + 16 <= mem.addr + mem.size) {
+            const u64* frame = reinterpret_cast<const u64*>(static_cast<uintptr_t>(fp_cur));
+            const u64 next_fp = frame[0];
+            const u64 saved_lr = frame[1];
+            if (saved_lr == 0) {
+              break;
+            }
+            bt[bt_count++] = saved_lr;
+            if (next_fp <= fp_cur) {
+              break;
+            }
+            fp_cur = next_fp;
+          }
+        }
+      }
+
+      if (paused_by_us) {
+        svcSetThreadActivity(t.handle, ThreadActivity_Runnable);
+      }
+
+      if (R_SUCCEEDED(ctx_rc)) {
+        std::fprintf(fp, "  tid=%llu name=\"%s\" pc=0x%llx lr=0x%llx sp=0x%llx fp=0x%llx",
+                     static_cast<unsigned long long>(t.tid),
+                     t.name.empty() ? "?" : t.name.c_str(),
+                     static_cast<unsigned long long>(ctx.pc.x),
+                     static_cast<unsigned long long>(ctx.lr),
+                     static_cast<unsigned long long>(ctx.sp),
+                     static_cast<unsigned long long>(ctx.fp));
+        if (bt_count > 0) {
+          std::fprintf(fp, " bt:");
+          for (int i = 0; i < bt_count; ++i) {
+            std::fprintf(fp, " 0x%llx", static_cast<unsigned long long>(bt[i]));
+          }
+        }
+        std::fprintf(fp, "\n");
+      } else {
+        std::fprintf(fp, "  tid=%llu name=\"%s\" ctx_rc=0x%x\n",
+                     static_cast<unsigned long long>(t.tid),
+                     t.name.empty() ? "?" : t.name.c_str(),
+                     ctx_rc);
+      }
+    }
+    // Profiling use (gameplay): an fsync per round on the SD card cost more than the sampling.
+    // Flushed every 64 rounds; the first rounds sync at once (crash locating at boot).
+    if (round < 64 || round % 64 == 0) {
+      std::fflush(fp);
+      if (round < 64) fsync(fileno(fp));
+    }
+    svcSleepThread(interval_ns);
+  }
+}
+
+}  // namespace
+
+void RegisterSwitch2SamplerThread(const char* name) {
+  u64 tid = 0;
+  svcGetThreadId(&tid, CUR_THREAD_HANDLE);
+  Switch2ThreadRegistry::Instance().Register(threadGetCurHandle(), tid, name ? name : "host");
+}
+
+void StartSwitch2SamplerIfEnabled() {
+  static std::once_flag once;
+  std::call_once(once, []() {
+    const int interval_ms = REXCVAR_GET(switch2_sampler_ms);
+    if (interval_ms <= 0) {
+      return;
+    }
+    pthread_t tid{};
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 64 * 1024);
+    pthread_create(
+        &tid, &attr,
+        [](void* arg) -> void* {
+          Switch2SamplerLoop(static_cast<int>(reinterpret_cast<intptr_t>(arg)));
+          return nullptr;
+        },
+        reinterpret_cast<void*>(static_cast<intptr_t>(interval_ms)));
+    pthread_attr_destroy(&attr);
+  });
+}
+#endif  // REX_PLATFORM_SWITCH2
