+//   REX_LOAD_STACK_* / REX_STORE_STACK_*  r1-relative: the thread's own stack frame
+//   REX_LOAD_LOOP_*                       loads inside a loop (between a label and a backward
+//                                         goto to it, stack ones too): what a spin-wait polls
+//   (other accesses keep their names)
+// and, with localized non-volatiles, drop the dead saves before the first label: storing a
+// local the function has not named yet (the prologue's std r31,-16(r1) of the caller's value,
+// which under non_volatile_as_local is a fresh local nobody reads back but the epilogue's load
+// into a local that dies at return).
+void classify_memory(std::string& body, bool dropDeadSaves) {
+  std::vector<std::string_view> lines;
+  for (size_t pos = 0; pos < body.size();) {
+    size_t nl = body.find('\n', pos);
+    if (nl == std::string::npos)
+      nl = body.size();
+    lines.emplace_back(body.data() + pos, nl - pos);
+    pos = nl + 1;
+  }
+  const size_t n = lines.size();
+  std::unordered_map<std::string_view, size_t> labelLine;
+  size_t firstLabel = n;
+  for (size_t i = 0; i < n; ++i) {
+    auto l = lines[i];
+    if (l.size() > 5 && l.compare(0, 4, "loc_") == 0 && l.back() == ':') {
+      labelLine.emplace(l.substr(0, l.size() - 1), i);
+      firstLabel = std::min(firstLabel, i);
+    }
+  }
+  std::vector<int> loopDepth(n + 1, 0);
+  for (size_t i = 0; i < n; ++i) {
+    auto l = lines[i];
+    for (size_t g = l.find("goto loc_"); g != std::string_view::npos;
+         g = l.find("goto loc_", g + 1)) {
+      size_t end = l.find(';', g);
+      if (end == std::string_view::npos)
+        continue;
+      auto it = labelLine.find(l.substr(g + 5, end - g - 5));
+      if (it != labelLine.end() && it->second <= i) {
+        loopDepth[it->second] += 1;
+        loopDepth[i + 1] -= 1;
+      }
+    }
+  }
+  std::string out;
+  out.reserve(body.size() + body.size() / 16);
+  std::unordered_set<std::string_view> named;
+  int depth = 0;
+  for (size_t i = 0; i < n; ++i) {
+    depth += loopDepth[i];
+    std::string_view l = lines[i];
+    if (dropDeadSaves && i < firstLabel) {
+      // a store whose value is a local not named before in the straight-line entry region
+      std::string_view value;
+      if (l.compare(0, 14, "\tREX_STORE_U64") == 0 || l.compare(0, 14, "\tREX_STORE_U32") == 0) {
+        size_t comma = l.rfind(", ");
+        if (comma != std::string_view::npos)
+          value = local_register_at(l, comma + 2);
+      } else if (constexpr std::string_view vsave =
+                     "\tsimde_mm_store_si128((simde__m128i*)REX_RAW_ADDR(ea), ";
+                 l.compare(0, vsave.size(), vsave) == 0) {
+        size_t v = l.find("(simde__m128i*)v");
+        if (v != std::string_view::npos)
+          value = local_register_at(l, v + 15);
+      }
+      if (!value.empty() && value[0] != 'c' && !named.count(value)) {
+        out += "\t// dead save of a localized register\n";
