diff --git a/include/rex/system/util/object_table.h b/include/rex/system/util/object_table.h
index df9bad43..c31ca24c 100644
--- a/include/rex/system/util/object_table.h
+++ b/include/rex/system/util/object_table.h
@@ -18,6 +18,8 @@
 #include <rex/system/xobject.h>
 #include <rex/system/xtypes.h>
 #include <rex/thread/mutex.h>
+#include <atomic>
+#include <mutex>
 
 namespace rex::stream {
 class ByteStream;
@@ -96,6 +98,21 @@ class ObjectTable {
   bool Resize(uint32_t new_capacity);
 
   rex::thread::global_critical_region global_critical_region_;
+  // The table itself (slots, capacity, resize). Mutators take the global region first, then this;
+  // LookupObject takes only this, so handle lookups (every NtSetEvent, NtReleaseSemaphore,
+  // NtWaitForSingleObject) no longer serialise on the process-wide region (Switch 2: ~8% of the game's
+  // main thread waited there).
+  std::recursive_mutex table_mutex_;
+  // Lookups do not take table_mutex_ either: on Switch 2 the game's main thread still spent ~10% of
+  // its time blocked in it, lookups queueing behind each other. A lookup only reads a slot and
+  // retains the object, so lookups run concurrently (readers_), and the rare writers that move the
+  // table or empty a slot (resize, add, remove, reset, purge, restore; always under table_mutex_,
+  // so one at a time) raise writer_ and wait until the lookups in flight have left.
+  std::atomic<uint32_t> readers_{0};
+  std::atomic<bool> writer_{false};
+  void BeginLookup();
+  void EndLookup() { readers_.fetch_sub(1, std::memory_order_release); }
+  class ExclusiveSlots;  // RAII writer side, see object_table.cpp
   std::mutex name_mutex_;
   uint32_t table_capacity_ = 0;
   ObjectTableEntry* table_ = nullptr;
