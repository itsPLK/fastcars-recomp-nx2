diff --git a/src/input/switch2/hid_input_driver.cpp b/src/input/switch2/hid_input_driver.cpp
new file mode 100644
index 00000000..23a20af9
--- /dev/null
+++ b/src/input/switch2/hid_input_driver.cpp
@@ -0,0 +1,164 @@
+/**
+ * @file        input/switch2/hid_input_driver.cpp
+ * @brief       Switch 2 controller input (libounce HID) as one XInput pad (see the header)
+ */
+
+#include <rex/input/switch2/hid_input_driver.h>
+
+#include <switch.h>
+
+#include <cstring>
+
+#include <rex/logging.h>
+
+namespace rex::input::switch2 {
+
+namespace {
+
+constexpr DeviceId kHidDevice = static_cast<DeviceId>(0x48494400);  // "HID"
+
+struct ButtonMap {
+  u64 hid;
+  uint16_t xinput;
+};
+
+// By position (see the header).
+constexpr ButtonMap kButtons[] = {
+    {HidNpadButton_B, X_INPUT_GAMEPAD_A},
+    {HidNpadButton_A, X_INPUT_GAMEPAD_B},
+    {HidNpadButton_Y, X_INPUT_GAMEPAD_X},
+    {HidNpadButton_X, X_INPUT_GAMEPAD_Y},
+    {HidNpadButton_L, X_INPUT_GAMEPAD_LEFT_SHOULDER},
+    {HidNpadButton_R, X_INPUT_GAMEPAD_RIGHT_SHOULDER},
+    {HidNpadButton_Plus, X_INPUT_GAMEPAD_START},
+    {HidNpadButton_Minus, X_INPUT_GAMEPAD_BACK},
+    {HidNpadButton_StickL, X_INPUT_GAMEPAD_LEFT_THUMB},
+    {HidNpadButton_StickR, X_INPUT_GAMEPAD_RIGHT_THUMB},
+    {HidNpadButton_Up, X_INPUT_GAMEPAD_DPAD_UP},
+    {HidNpadButton_Down, X_INPUT_GAMEPAD_DPAD_DOWN},
+    {HidNpadButton_Left, X_INPUT_GAMEPAD_DPAD_LEFT},
+    {HidNpadButton_Right, X_INPUT_GAMEPAD_DPAD_RIGHT},
+};
+
+int16_t Axis(s32 v) {
+  // HID sticks report -32767..32767, up and right positive, as XInput expects.
+  if (v > 32767) v = 32767;
+  if (v < -32768) v = -32768;
+  return int16_t(v);
+}
+
+}  // namespace
+
+HidInputDriver::HidInputDriver(rex::ui::Window* window, size_t window_z_order)
+    : InputDriver(window, window_z_order) {}
+
+HidInputDriver::~HidInputDriver() {
+  delete static_cast<PadState*>(pad_);
+}
+
+X_STATUS HidInputDriver::Setup() {
+  // One player, standard controller styles (handheld, Joy-Con pair, Pro Controller).
+  padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+  auto* pad = new PadState();
+  padInitializeDefault(pad);
+  pad_ = pad;
+  REXLOG_INFO("Switch 2 HID input: player 1 as XInput user 0");
+  return X_STATUS_SUCCESS;
+}
+
+void HidInputDriver::EnumerateDevices(std::vector<DeviceInfo>& out) {
+  // Always present (handheld mode has the controls attached), so the game never pauses for a pad.
+  DeviceInfo info;
+  info.id = kHidDevice;
+  info.name = "Switch 2 controller";
+  out.push_back(info);
+}
+
+X_RESULT HidInputDriver::GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                               X_INPUT_CAPABILITIES* out_caps) {
+  (void)flags;
+  if (id != kHidDevice) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  if (out_caps) {
+    std::memset(out_caps, 0, sizeof(*out_caps));
+    out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+    out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+    out_caps->gamepad.buttons = 0xF3FF;
+    out_caps->gamepad.left_trigger = 0xFF;
+    out_caps->gamepad.right_trigger = 0xFF;
+    out_caps->gamepad.thumb_lx = static_cast<int16_t>(0xFFFFu);
+    out_caps->gamepad.thumb_ly = static_cast<int16_t>(0xFFFFu);
+    out_caps->gamepad.thumb_rx = static_cast<int16_t>(0xFFFFu);
+    out_caps->gamepad.thumb_ry = static_cast<int16_t>(0xFFFFu);
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT HidInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
+  if (id != kHidDevice) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  std::lock_guard lock(mutex_);
+  auto* pad = static_cast<PadState*>(pad_);
+  X_INPUT_GAMEPAD g{};
+  // [-] + [+] is the game's settings menu (it takes the pad while open, is_active() false): the
+  // two are hidden from the game from when both are held until both are released, and whatever is
+  // held when the pad comes back stays hidden until released (B closing the menu is no A press).
+  static bool combo = false, was_inactive = false;
+  static u64 suppressed = 0;
+  const bool active = is_active();
+  if (pad && !active) {
+    was_inactive = true;
+  } else if (pad) {
+    padUpdate(pad);
+    u64 held = padGetButtons(pad);
+    if (was_inactive) {
+      was_inactive = false;
+      suppressed = held;
+    }
+    suppressed &= held;
+    const u64 menu_buttons = HidNpadButton_Minus | HidNpadButton_Plus;
+    if ((held & menu_buttons) == menu_buttons) combo = true;
+    if (!(held & menu_buttons)) combo = false;
+    if (combo) held &= ~menu_buttons;
+    held &= ~suppressed;
+    uint16_t buttons = 0;
+    for (const auto& b : kButtons) {
+      if (held & b.hid) buttons |= b.xinput;
+    }
+    g.buttons = buttons;
+    g.left_trigger = (held & HidNpadButton_ZL) ? 0xFF : 0;
+    g.right_trigger = (held & HidNpadButton_ZR) ? 0xFF : 0;
+    const HidAnalogStickState l = padGetStickPos(pad, 0);
+    const HidAnalogStickState r = padGetStickPos(pad, 1);
+    g.thumb_lx = Axis(l.x);
+    g.thumb_ly = Axis(l.y);
+    g.thumb_rx = Axis(r.x);
+    g.thumb_ry = Axis(r.y);
+  }
+  // XInput semantics: the packet number changes only when the state does.
+  if (std::memcmp(&g, &last_, sizeof(g)) != 0) {
+    last_ = g;
+    ++packet_number_;
+  }
+  if (out_state) {
+    out_state->packet_number = packet_number_;
+    out_state->gamepad = g;
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT HidInputDriver::SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) {
+  (void)vibration;
+  return id == kHidDevice ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+X_RESULT HidInputDriver::GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                                            X_INPUT_KEYSTROKE* out_keystroke) {
+  (void)flags;
+  (void)out_keystroke;
+  return id == kHidDevice ? X_ERROR_EMPTY : X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+}  // namespace rex::input::switch2
