+/**
+ * @file        ui/window_switch2.h
+ * @brief       Switch 2 window: the screen, with no surface of its own
+ *
+ * A Horizon process gets one VI layer (the default NWindow), and a VK_NN_vi_surface can be created
+ * on it once. On Switch 2 the title's own renderer owns it (fastcars_native=on, gpu_skip_rendering),
+ * so this window reports the screen size and focus and gives the SDK's presenter no surface.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string_view>
+
+#include <rex/ui/window.h>
+#include <rex/ui/windowed_app_context_switch2.h>
+
+namespace rex::ui {
+
+class WindowSwitch2 final : public Window {
+ public:
+  WindowSwitch2(WindowedAppContext& app_context, const std::string_view title,
+                uint32_t desired_logical_width, uint32_t desired_logical_height);
+  ~WindowSwitch2() override;
+
+  // Called by Switch2WindowedAppContext on the UI thread.
+  void HandleCloseRequest();
+  void HandlePaint();
+
+ protected:
+  bool OpenImpl() override;
+  void RequestCloseImpl() override;
+  std::unique_ptr<Surface> CreateSurfaceImpl(Surface::TypeFlags allowed_types) override;
+  void RequestPaintImpl() override;
+
+ private:
+  Switch2WindowedAppContext& switch2_app_context() const {
+    return static_cast<Switch2WindowedAppContext&>(app_context());
+  }
+  void PerformClose();
+
+  bool open_ = false;
+};
+
+}  // namespace rex::ui
