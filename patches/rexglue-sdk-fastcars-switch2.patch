+  rex::thread::Semaphore* semaphore_;
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  bool running_ = true;
+  std::deque<float*> queued_;
+  std::vector<float*> spare_;
+  std::thread worker_;
+};
