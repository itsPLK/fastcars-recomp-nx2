diff --git a/src/core/memory_switch2.cpp b/src/core/memory_switch2.cpp
new file mode 100644
index 00000000..3f2142ad
--- /dev/null
+++ b/src/core/memory_switch2.cpp
@@ -0,0 +1,248 @@
+/**
+ * Switch 2 (Horizon, libounce) host memory: rex::memory primitives without mmap.
+ *
+ * A homebrew process on kaiHEN gets its heap, committed from the start, and nothing else: no
+ * second mapping of one memory, no svcMapPhysicalMemory, no recoverable faults (hardware probe,
+ * docs/SWITCH2_PORT_PLAN.md). So:
+ * - The guest arena is one heap block (switch2::AllocateGuestArena), zeroed once. The desktop
+ *   SDK never returns guest pages to the host either (BaseHeap::Decommit only updates its page
+ *   table), so committing a page inside the arena keeps its contents, as on desktop, and the
+ *   commit/decommit/release calls the guest heaps make there have nothing to do.
+ * - Other blocks (AllocFixed with no base address) come from the heap, 64 KB aligned.
+ * - Protection: not enforced (no faults to deliver it with); nothing may depend on it.
+ * - File mappings: unsupported. The aliasing guest windows are folded by address translation
+ *   (rex/system/xmemory.h), not mapped.
+ */
+#include <rex/platform.h>
+
+static_assert(REX_PLATFORM_SWITCH2, "Switch 2 only");
+
+#include <switch.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <mutex>
+
+#include <rex/logging.h>
+#include <rex/memory/switch2.h>
+#include <rex/memory/utils.h>
+
+namespace rex::memory {
+
+namespace {
+
+constexpr size_t kPage = 0x1000;
+constexpr size_t kGranularity = 0x10000;
+
+size_t AlignUp(size_t value, size_t alignment) {
+  return (value + alignment - 1) & ~(alignment - 1);
+}
+
+struct State {
+  std::mutex mutex;
+  uintptr_t arena_base = 0;
+  size_t arena_size = 0;
+  std::map<uintptr_t, size_t> blocks;  // AllocFixed(nullptr) blocks: base -> size
+};
+
+State& GetState() {
+  static State state;
+  return state;
+}
+
+bool InArena(const State& s, uintptr_t base, size_t size) {
+  return s.arena_base && base >= s.arena_base && base + size <= s.arena_base + s.arena_size;
+}
+
+// The AllocFixed(nullptr) block holding [base, base + size), or blocks.end().
+std::map<uintptr_t, size_t>::iterator FindBlock(State& s, uintptr_t base, size_t size) {
+  auto it = s.blocks.upper_bound(base);
+  if (it == s.blocks.begin()) return s.blocks.end();
+  --it;
+  return base + size <= it->first + it->second ? it : s.blocks.end();
+}
+
+}  // namespace
+
+size_t page_size() {
+  return kPage;
+}
+
+size_t allocation_granularity() {
+  return kGranularity;
+}
+
+bool IsWritableExecutableMemorySupported() {
+  // Nothing in the runtime executes generated code from guest memory.
+  return false;
+}
+
+void* AllocFixed(void* base_address, size_t length, AllocationType allocation_type,
+                 PageAccess access) {
+  (void)access;
+  State& s = GetState();
+  std::lock_guard lock(s.mutex);
+  const uintptr_t base = reinterpret_cast<uintptr_t>(base_address);
+  if (base) {
+    // Inside the arena or a block we handed out: already committed.
+    if (InArena(s, base, length) || FindBlock(s, base, length) != s.blocks.end()) {
+      return base_address;
+    }
+    REXSYS_ERROR("switch2: AllocFixed at 0x{:X}+0x{:X} outside the guest arena and every block",
+                 base, length);
+    return nullptr;
+  }
+  const size_t size = AlignUp(length, kGranularity);
+  void* p = std::aligned_alloc(kGranularity, size);
+  if (!p) {
+    REXSYS_ERROR("switch2: no heap for a 0x{:X}-byte block", size);
+    return nullptr;
+  }
+  if (allocation_type != AllocationType::kReserve) {
+    std::memset(p, 0, size);
+  }
+  s.blocks[reinterpret_cast<uintptr_t>(p)] = size;
+  return p;
+}
+
+bool DeallocFixed(void* base_address, size_t length, DeallocationType deallocation_type) {
+  (void)length;
+  State& s = GetState();
+  std::lock_guard lock(s.mutex);
+  const uintptr_t base = reinterpret_cast<uintptr_t>(base_address);
+  if (deallocation_type == DeallocationType::kRelease) {
+    auto it = s.blocks.find(base);
+    if (it != s.blocks.end()) {
+      std::free(base_address);
+      s.blocks.erase(it);
+    }
+    // Releases inside the arena (guest heap Dispose) keep the arena.
+    return true;
+  }
+  // Decommit: memory stays committed and keeps its contents (as on desktop, see the file comment).
+  return true;
+}
+
+bool Protect(void* base_address, size_t length, PageAccess access, PageAccess* out_old_access) {
+  (void)base_address;
+  (void)length;
+  (void)access;
+  if (out_old_access) {
+    *out_old_access = PageAccess::kReadWrite;
+  }
+  return true;
+}
+
+bool QueryProtect(void* base_address, size_t& length, PageAccess& access_out) {
+  State& s = GetState();
+  const uintptr_t address = reinterpret_cast<uintptr_t>(base_address) & ~(kPage - 1);
+  {
+    std::lock_guard lock(s.mutex);
+    if (InArena(s, address, 1)) {
+      length = s.arena_base + s.arena_size - address;
+      access_out = PageAccess::kReadWrite;
+      return true;
+    }
+    auto it = FindBlock(s, address, 1);
+    if (it != s.blocks.end()) {
+      length = it->first + it->second - address;
+      access_out = PageAccess::kReadWrite;
+      return true;
+    }
+  }
+  MemoryInfo info{};
+  u32 page_info = 0;
+  if (R_FAILED(svcQueryMemory(&info, &page_info, address))) {
+    length = 0;
+    access_out = PageAccess::kNoAccess;
+    return false;
+  }
+  length = size_t(info.addr + info.size - address);
+  switch (info.perm & (Perm_R | Perm_W | Perm_X)) {
+    case Perm_R:
+      access_out = PageAccess::kReadOnly;
+      break;
+    case Perm_Rw:
+      access_out = PageAccess::kReadWrite;
+      break;
+    case Perm_Rx:
+      access_out = PageAccess::kExecuteReadOnly;
+      break;
+    default:
+      access_out = info.type == MemType_Unmapped ? PageAccess::kNoAccess : PageAccess::kReadWrite;
+      break;
+  }
+  return true;
+}
+
+FileMappingHandle CreateFileMappingHandle(const std::filesystem::path& path, size_t length,
+                                          PageAccess access, bool commit) {
+  (void)path;
+  (void)length;
+  (void)access;
+  (void)commit;
+  return kFileMappingHandleInvalid;
+}
+
+void CloseFileMappingHandle(FileMappingHandle handle, const std::filesystem::path& path) {
+  (void)handle;
+  (void)path;
+}
+
+void* MapFileView(FileMappingHandle handle, void* base_address, size_t length, PageAccess access,
+                  size_t file_offset) {
+  (void)handle;
+  (void)base_address;
+  (void)length;
+  (void)access;
+  (void)file_offset;
+  return nullptr;
+}
+
+bool UnmapFileView(FileMappingHandle handle, void* base_address, size_t length) {
+  (void)handle;
+  (void)base_address;
+  (void)length;
+  return false;
+}
+
+//-----------------------------------------------------------------------------
+// rex/memory/switch2.h
+//-----------------------------------------------------------------------------
+
+namespace switch2 {
+
+void* AllocateGuestArena(size_t size) {
+  State& s = GetState();
+  std::lock_guard lock(s.mutex);
+  if (s.arena_base) {
+    REXSYS_ERROR("switch2: the guest arena already exists");
+    return nullptr;
+  }
+  size = AlignUp(size, kGranularity);
+  void* p = std::aligned_alloc(kGranularity, size);
+  if (!p) {
+    REXSYS_ERROR("switch2: no heap for the 0x{:X}-byte guest arena", size);
+    return nullptr;
+  }
+  // Zeroed once: fresh guest pages read as zero, as with a new file mapping on desktop.
+  std::memset(p, 0, size);
+  s.arena_base = reinterpret_cast<uintptr_t>(p);
+  s.arena_size = size;
+  return p;
+}
+
+void FreeGuestArena() {
+  State& s = GetState();
+  std::lock_guard lock(s.mutex);
+  if (s.arena_base) {
+    std::free(reinterpret_cast<void*>(s.arena_base));
+    s.arena_base = 0;
+    s.arena_size = 0;
+  }
+}
+
+}  // namespace switch2
+
+}  // namespace rex::memory
