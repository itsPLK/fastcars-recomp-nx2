diff --git a/src/ui/window_switch2.cpp b/src/ui/window_switch2.cpp
new file mode 100644
index 00000000..59b72b99
--- /dev/null
+++ b/src/ui/window_switch2.cpp
@@ -0,0 +1,89 @@
+/**
+ * @file        ui/window_switch2.cpp
+ * @brief       Switch 2 window: the screen, with no surface of its own (see window_switch2.h)
+ */
+
+#include <rex/ui/window_switch2.h>
+
+#include <switch.h>
+
+#include <rex/logging.h>
+
+namespace rex::ui {
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                       const std::string_view title, uint32_t desired_logical_width,
+                                       uint32_t desired_logical_height) {
+  return std::make_unique<WindowSwitch2>(app_context, title, desired_logical_width,
+                                         desired_logical_height);
+}
+
+WindowSwitch2::WindowSwitch2(WindowedAppContext& app_context, const std::string_view title,
+                             uint32_t desired_logical_width, uint32_t desired_logical_height)
+    : Window(app_context, title, desired_logical_width, desired_logical_height) {}
+
+WindowSwitch2::~WindowSwitch2() {
+  EnterDestructor();
+  if (open_) {
+    switch2_app_context().UnregisterWindow(this);
+    open_ = false;
+  }
+}
+
+bool WindowSwitch2::OpenImpl() {
+  // The window is the screen: the default NWindow's size, whatever was asked for.
+  u32 width = 1280, height = 720;
+  if (NWindow* nw = nwindowGetDefault()) {
+    nwindowGetDimensions(nw, &width, &height);
+  }
+  open_ = true;
+  switch2_app_context().RegisterWindow(this);
+  WindowDestructionReceiver destruction_receiver(this);
+  OnActualSizeUpdate(width, height, destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return true;
+  }
+  OnFocusUpdate(true, destruction_receiver);
+  return true;
+}
+
+void WindowSwitch2::RequestCloseImpl() {
+  PerformClose();
+}
+
+void WindowSwitch2::PerformClose() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (destruction_receiver.IsWindowDestroyed()) {
+    return;
+  }
+  if (open_) {
+    switch2_app_context().UnregisterWindow(this);
+    open_ = false;
+  }
+  OnAfterClose();
+}
+
+void WindowSwitch2::HandleCloseRequest() {
+  WindowDestructionReceiver destruction_receiver(this);
+  if (SendCloseRequestToListeners(destruction_receiver) &&
+      !destruction_receiver.IsWindowDestroyed()) {
+    PerformClose();
+  }
+}
+
+std::unique_ptr<Surface> WindowSwitch2::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  // The process's one VI surface belongs to the title's renderer (see the header).
+  (void)allowed_types;
+  return nullptr;
+}
+
+void WindowSwitch2::RequestPaintImpl() {
+  switch2_app_context().RequestPaint();
+}
+
+void WindowSwitch2::HandlePaint() {
+  OnPaint();
+}
+
+}  // namespace rex::ui
