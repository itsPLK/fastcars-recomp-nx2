 namespace rex::audio::nop {
 
+namespace {
+
+class NopAudioDriver final : public AudioDriver {
+ public:
+  NopAudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore) {
+    pacer_ = std::thread([this]() {
+      while (running_.load(std::memory_order_relaxed)) {
+        if (pending_frames_.load(std::memory_order_acquire) > 0) {
+          pending_frames_.fetch_sub(1, std::memory_order_acq_rel);
+          if (semaphore_) {
+            semaphore_->Release(1, nullptr);
+          }
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+      }
+    });
+  }
+
+  ~NopAudioDriver() override {
+    running_.store(false, std::memory_order_relaxed);
+    if (pacer_.joinable()) {
+      pacer_.join();
+    }
+  }
+
+  void SubmitFrame(uint32_t /*samples_ptr*/) override {
+    int cur = pending_frames_.load(std::memory_order_relaxed);
+    if (cur < 16) {
+      pending_frames_.fetch_add(1, std::memory_order_release);
+    }
+  }
+
+ private:
+  rex::thread::Semaphore* semaphore_ = nullptr;
+  std::atomic<bool> running_{true};
+  std::atomic<int> pending_frames_{0};
+  std::thread pacer_;
+};
