+
+#include <switch.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <string>
+
+#include <rex/logging.h>
+#include <rex/ui/window_switch2.h>
+
+namespace rex::ui {
+
+Switch2WindowedAppContext::~Switch2WindowedAppContext() {
+  // Same shutdown contract as the SDL context: run what is still queued.
+  ExecutePendingFunctionsFromUIThread();
+}
+
+bool Switch2WindowedAppContext::Initialize() {
+  // Ask to be told about HOME-menu exits instead of being killed, so the normal close path
+  // (guest, audio and GPU threads stopped by window listeners) runs.
+  appletLockExit();
+  return true;
+}
+
+void Switch2WindowedAppContext::NotifyUILoopOfPendingFunctions() {
+  {
+    std::lock_guard lock(wake_mutex_);
+    wake_pending_ = true;
+  }
+  wake_cv_.notify_one();
+}
+
+void Switch2WindowedAppContext::PlatformQuitFromUIThread() {
+  NotifyUILoopOfPendingFunctions();
+}
+
+void Switch2WindowedAppContext::RegisterWindow(WindowSwitch2* window) {
+  windows_.push_back(window);
+}
+
+void Switch2WindowedAppContext::UnregisterWindow(WindowSwitch2* window) {
+  windows_.erase(std::remove(windows_.begin(), windows_.end(), window), windows_.end());
+}
+
+void Switch2WindowedAppContext::RequestPaint() {
+  if (!paint_pending_.exchange(true, std::memory_order_acq_rel)) {
+    NotifyUILoopOfPendingFunctions();
+  }
+}
+
+extern std::string g_switch2_launch_note;  // windowed_app_main_switch2.cpp
+
+int Switch2WindowedAppContext::RunMainMessageLoop() {
+  if (!g_switch2_launch_note.empty()) REXLOG_INFO("{}", g_switch2_launch_note);
+  bool applet_running = true;
+  // Quit only through HOME -> Close: the system then expects the process to end. A quit of our own
+  // ([-] + [+] before) ended it unasked, and the system reported "the software was closed because
+  // an error occurred".
+  while (!HasQuitFromUIThread()) {
+    {
+      std::unique_lock lock(wake_mutex_);
+      wake_cv_.wait_for(lock, std::chrono::milliseconds(16), [this] { return wake_pending_; });
+      wake_pending_ = false;
+    }
+    ExecutePendingFunctionsFromUIThread();
+    if (HasQuitFromUIThread()) {
+      break;
+    }
+    if (paint_pending_.exchange(false, std::memory_order_acq_rel)) {
+      // Copy: a paint handler may close (unregister) a window.
+      std::vector<WindowSwitch2*> windows = windows_;
+      for (WindowSwitch2* window : windows) {
+        window->HandlePaint();
+      }
+    }
+    // appletMainLoop handles applet messages; false means HOME asked the program to exit.
+    if (applet_running && !appletMainLoop()) {
+      applet_running = false;
+      REXLOG_INFO("Switch 2: exit requested by the system");
+      ProcessQuitRequest();
+    }
+  }
+  appletUnlockExit();
+  return EXIT_SUCCESS;
+}
+
+void Switch2WindowedAppContext::ProcessQuitRequest() {
+  // The normal close-request path, as on desktop: listeners stop the guest first.
+  std::vector<WindowSwitch2*> windows = windows_;
+  for (WindowSwitch2* window : windows) {
+    window->HandleCloseRequest();
+  }
+  if (windows_.empty() && !HasQuitFromUIThread()) {
+    QuitFromUIThread();
+  }
+}
+
+}  // namespace rex::ui
diff --git a/src/ui/windowed_app_main_switch2.cpp b/src/ui/windowed_app_main_switch2.cpp
new file mode 100644
index 00000000..b7cb02e7
--- /dev/null
+++ b/src/ui/windowed_app_main_switch2.cpp
@@ -0,0 +1,139 @@
+/**
+ * @file        ui/windowed_app_main_switch2.cpp
+ * @brief       Entry point for windowed applications on Switch 2 (no SDL3)
+ *
+ * The loader passes only the NRO path (argv[0]). The app folder follows the usual homebrew layout,
+ * one folder per app under sdmc:/switch:
+ *   .../fastcars/fastcars.nro   -> that folder (NRO and data together)
+ *   .../switch/fastcars.nro -> sdmc:/switch/fastcars (a folder named after the NRO, next to it)
+ *   no usable argv[0]   -> REX_SWITCH2_APP_DIR (sdmc:/switch/fastcars)
+ * An install from before this layout (sdmc:/fastcars with args.txt) is used while the new folder has
+ * no args.txt. Arguments come from <app folder>/args.txt (one or more per line, # comments),
+ * appended after any the loader passed (nxlink). The working directory becomes the app folder,
+ * so relative paths in args.txt (game data, logs) resolve inside it.
+ */
+
+#include <switch.h>
+
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/thread.h>
+#include <rex/ui/windowed_app.h>
+#include <rex/ui/windowed_app_context_switch2.h>
+
+#ifndef REX_SWITCH2_APP_DIR
+#define REX_SWITCH2_APP_DIR "sdmc:/switch/fastcars"
+#endif
+#define REX_SWITCH2_LEGACY_APP_DIR "sdmc:/fastcars"
+
+namespace rex::ui {
+// Where the app folder came from; logged by the main loop (the log file is open by then).
+std::string g_switch2_launch_note;
+}  // namespace rex::ui
+
+namespace {
+
+int RunWindowedApp(int argc, char** argv) {
+  auto remaining = rex::cvar::Init(argc, argv);
+  rex::cvar::ApplyEnvironment();
+  rex::InitLoggingEarly();
+  rex::thread::StartSwitch2SamplerIfEnabled();
+
+  int result;
+  {
+    rex::ui::Switch2WindowedAppContext app_context;
+    if (!app_context.Initialize()) {
+      return EXIT_FAILURE;
+    }
+    std::unique_ptr<rex::ui::WindowedApp> app = rex::ui::GetWindowedAppCreator()(app_context);
+
+    const auto& option_names = app->GetPositionalOptions();
+    std::map<std::string, std::string> parsed;
+    size_t count = std::min(remaining.size(), option_names.size());
+    for (size_t i = 0; i < count; ++i) {
+      parsed[option_names[i]] = remaining[i];
+    }
+    app->SetParsedArguments(std::move(parsed));
+
+    result = app->OnInitialize() ? app_context.RunMainMessageLoop() : EXIT_FAILURE;
+    app->InvokeOnDestroy();
+  }
+  return result;
+}
+
+void ReadArgs(const std::string& path, std::vector<std::string>& args) {
+  std::ifstream file(path);
+  std::string line;
+  while (std::getline(file, line)) {
+    if (auto hash = line.find('#'); hash != std::string::npos) {
+      line.resize(hash);
+    }
+    std::istringstream words(line);
+    std::string word;
+    while (words >> word) {
+      args.push_back(word);
+    }
+  }
+}
+
+bool FileExists(const std::string& path) {
+  std::ifstream f(path);
+  return f.good();
+}
+
+// See the file comment.
+std::string AppDir(const std::string& nro) {
+  std::string dir = REX_SWITCH2_APP_DIR;
+  const size_t slash = nro.find_last_of('/');
+  if (slash != std::string::npos && nro.size() > 4 && nro.compare(nro.size() - 4, 4, ".nro") == 0) {
+    const std::string parent = nro.substr(0, slash);
+    const std::string stem = nro.substr(slash + 1, nro.size() - slash - 5);
+    const size_t pslash = parent.find_last_of('/');
+    const std::string parent_name = pslash == std::string::npos ? parent : parent.substr(pslash + 1);
+    dir = parent_name == stem ? parent : parent + "/" + stem;
+  }
+  if (!FileExists(dir + "/args.txt") && FileExists(REX_SWITCH2_LEGACY_APP_DIR "/args.txt")) {
+    dir = REX_SWITCH2_LEGACY_APP_DIR;
+  }
+  return dir;
+}
+
+}  // namespace
+
+// The title's start screen, if it has one (a weak reference: absent in other executables).
+extern "C" void rex_switch2_splash() __attribute__((weak));
+
+int main(int argc, char* argv[]) {
+  std::vector<std::string> args;
+  for (int i = 0; i < argc; ++i) {
+    args.emplace_back(argv[i]);
+  }
+  if (args.empty()) {
+    args.emplace_back(REX_SWITCH2_APP_DIR "/fastcars.nro");
+  }
+  const std::string app_dir = AppDir(args[0]);
+  rex::ui::g_switch2_launch_note = "Switch 2: launched as '" + args[0] + "', app folder " + app_dir;
+  chdir(app_dir.c_str());
+  ReadArgs(app_dir + "/args.txt", args);
+  if (rex_switch2_splash) rex_switch2_splash();
+
+  std::vector<char*> argv_ptrs;
+  argv_ptrs.reserve(args.size() + 1);
+  for (auto& arg : args) {
+    argv_ptrs.push_back(arg.data());
+  }
+  argv_ptrs.push_back(nullptr);
+  return RunWindowedApp(static_cast<int>(args.size()), argv_ptrs.data());
+}
