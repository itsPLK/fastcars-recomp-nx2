@@ -0,0 +1,41 @@
+/**
+ * @file        input/switch2/hid_input_driver.h
+ * @brief       Switch 2 controller input (libounce HID) as one XInput pad
+ *
+ * Player 1's controller, merged with handheld mode (padInitializeDefault), reported as XInput
+ * user 0. Buttons map by position, as SDL's gamepad mapping does on desktop: the bottom face
+ * button (Switch B) is Xbox A, the right one (Switch A) Xbox B, left (Y) X, top (X) Y. L/R are the
+ * shoulders, ZL/ZR the triggers (digital), + Start, - Back. Vibration is accepted and ignored.
+ */
+
+#pragma once
+
+#include <mutex>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::switch2 {
+
+class HidInputDriver final : public InputDriver {
+ public:
+  explicit HidInputDriver(rex::ui::Window* window, size_t window_z_order);
+  ~HidInputDriver() override;
+
+  X_STATUS Setup() override;
+
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override;
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override;
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                 X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags,
+                              X_INPUT_KEYSTROKE* out_keystroke) override;
+
+ private:
+  std::mutex mutex_;
+  uint32_t packet_number_ = 1;
+  X_INPUT_GAMEPAD last_{};
+  void* pad_ = nullptr;  // PadState (libounce), kept opaque here
+};
+
+}  // namespace rex::input::switch2
diff --git a/include/rex/memory/alias_audit.h b/include/rex/memory/alias_audit.h
new file mode 100644
index 00000000..63da0c8e
--- /dev/null
+++ b/include/rex/memory/alias_audit.h
@@ -0,0 +1,43 @@
+/**
+ * Alias audit (desktop diagnostic, REX_ALIAS_AUDIT=1): does guest code reach the same physical
+ * page through more than one of the Xbox 360 physical windows (0xA/0xC/0xE, 0x7F GPU writeback)?
+ *
+ * The Switch 2 port cannot map one memory block at several addresses as freely as mmap does
+ * (docs/SWITCH2_PORT_PLAN.md). If every physical page is only ever touched through one window,
+ * the windows can have separate memory there. This audit protects the four windows' host views,
+ * records the window of the first touch of every host page in the access-violation callback,
+ * opens that page in that window only, and logs every page seen through a second window.
+ * The raw physical view (host code) is not audited.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/memory/utils.h>
+
+namespace rex::memory::alias_audit {
+
+// True when REX_ALIAS_AUDIT=1 is set (read once).
+bool Enabled();
+
+// Registers a window's host view (base, size) and protects it. `name` is a short tag ("A").
+void RegisterWindow(uint8_t* view_base, size_t size, const char* name, uint32_t guest_base);
+
+// Exception handler hook: the faulting instruction's address, for OnFault's report (which module
+// made the access: the recompiled game or host code).
+void SetFaultPc(uint64_t pc);
+
+// Access-violation callback hook: returns true if the fault was a first touch of an audited page
+// (recorded and opened), false otherwise.
+bool OnFault(void* host_address, bool is_write);
+
+// Protect() / commit hook: for ranges inside audited windows, applies the request only to pages
+// already opened by OnFault and returns true; returns false for other ranges.
+bool FilterProtect(void* base_address, size_t length, PageAccess access);
+
+// Opens every audited page in [buffer, buffer + length) by touching it (host system calls such as
+// pread return EFAULT on a protected page instead of faulting).
+void TouchRange(void* buffer, size_t length);
+
+}  // namespace rex::memory::alias_audit
diff --git a/include/rex/memory/switch2.h b/include/rex/memory/switch2.h
new file mode 100644
index 00000000..594bf58d
--- /dev/null
+++ b/include/rex/memory/switch2.h
@@ -0,0 +1,33 @@
+/**
+ * Switch 2 (Horizon) guest-memory primitives that have no POSIX equivalent.
+ *
+ * What the console allows (hardware probe, docs/SWITCH2_PORT_PLAN.md): no way to see one memory
+ * at two addresses (shared/transfer/process memory SVCs are outside the game policy), no
+ * svcMapPhysicalMemory (no system resource), no recoverable faults. All memory a homebrew process
+ * gets is its heap, committed from the start.
+ *
+ * So the guest arena is one plain heap block. The Xbox 360 windows that alias each other (the
+ * physical windows 0xA/0xC/0xE and 0x7F, the XEX 0x8/0x9 pair) are folded onto one host copy by
+ * address translation instead of by mappings: see rex::memory::detail::GuestFoldOffset in
+ * rex/system/xmemory.h, which must agree with REX_PHYS_HOST_OFFSET in the game's prefix header.
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_SWITCH2
+
+namespace rex::memory::switch2 {
+
+// Allocates the guest arena: `size` bytes, 64 KB aligned, from the heap. Every page starts
+// uncommitted; rex::memory::AllocFixed commits (zeroes) pages inside it. One arena per process.
+// Returns nullptr when the heap cannot hold it.
+void* AllocateGuestArena(size_t size);
+void FreeGuestArena();
+
+}  // namespace rex::memory::switch2
+
+#endif  // REX_PLATFORM_SWITCH2
