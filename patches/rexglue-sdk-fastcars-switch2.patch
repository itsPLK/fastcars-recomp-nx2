--- /dev/null
+++ b/src/core/seh_switch2.cpp
@@ -0,0 +1,70 @@
+/**
+ * Switch 2 SEH: the same contract as seh_posix.cpp (a fault inside SEH_TRY throws SehException,
+ * caught by SEH_CATCH), without signals. exception_handler_switch2.cpp sees the fault first
+ * (__libnx_exception_handler); when seh_active() is set for the faulting thread it calls
+ * seh_switch2_redirect, which resumes the thread at a trampoline that throws, "called" from the
+ * faulting instruction, exactly as a throw from a POSIX signal frame unwinds.
+ */
+#include <rex/platform.h>
+#include <rex/platform/seh.h>
+
+static_assert(REX_PLATFORM_SWITCH2, "Switch 2 only");
+
+#include <cstdlib>
+
+#include <rex/platform/exception_switch2.h>
+#include <rex/platform/exceptions.h>
+
+namespace rex::platform {
+
+static thread_local SehThreadState tls_seh_state;
+static thread_local bool tls_seh_active = false;
+
+SehThreadState& seh_thread_state() {
+  return tls_seh_state;
+}
+
+int seh_filter(uint32_t /*code*/, void* /*ep*/) {
+  return 0;
+}
+
+bool& seh_active() {
+  return tls_seh_active;
+}
+
+void seh_initialize() {
+  // Nothing to install: exception_handler_switch2.cpp owns __libnx_exception_handler.
+  g_seh_initialized.store(true);
+}
+
+[[noreturn]] void seh_rethrow() {
+  // No signal to re-raise on Horizon: an SEH exception nobody handles ends the program.
+  std::abort();
+}
+
+namespace switch2 {
+
+// Entered by rex_switch2_resume in place of the faulting instruction, on the faulting thread's
+// stack, with lr = fault pc + 4 so the unwinder continues in the faulting function.
+extern "C" [[noreturn]] void rex_switch2_seh_throw() {
+  const SehThreadState& state = tls_seh_state;
+  throw SehException(static_cast<SehException::Code>(state.code), state.info[1]);
+}
+
+// Called from the exception handler with the faulting thread's context. Returns false (the
+// caller reports a crash) when the thread is not inside an SEH region.
+bool seh_redirect(ResumeFrame* frame, uint32_t code, uintptr_t fault_address) {
+  if (!tls_seh_active) {
+    return false;
+  }
+  tls_seh_state.code = code;
+  tls_seh_state.info[0] = 0;
+  tls_seh_state.info[1] = fault_address;
+  frame->x[30] = frame->pc + 4;
+  frame->pc = reinterpret_cast<uint64_t>(&rex_switch2_seh_throw);
+  rex_switch2_resume(frame);
+}
+
+}  // namespace switch2
+
+}  // namespace rex::platform
