@@ -0,0 +1,105 @@
+/**
+ * Switch 2: MappedMemory without mmap. The file (or the requested range) is read into memory;
+ * read-write mappings are written back on Flush and Close. Used for small files (XEX headers,
+ * content packages' metadata, saves); game archives go through FileHandle reads instead.
+ */
+#include <rex/platform.h>
+
+static_assert(REX_PLATFORM_SWITCH2, "Switch 2 only");
+
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/memory/mapped_memory.h>
+
+namespace rex::memory {
+
+class Switch2MappedMemory : public MappedMemory {
+ public:
+  Switch2MappedMemory(void* data, size_t size, FILE* file, size_t offset, Mode mode)
+      : MappedMemory(data, size), file_(file), offset_(offset), mode_(mode) {}
+
+  ~Switch2MappedMemory() override { Close(0); }
+
+  void Close(uint64_t truncate_size) override {
+    if (file_) {
+      WriteBack();
+      if (truncate_size) {
+        rex::filesystem::TruncateStdioFile(file_, truncate_size);
+      }
+      std::fclose(file_);
+      file_ = nullptr;
+    }
+    std::free(data_);
+    data_ = nullptr;
+  }
+
+  void Flush() override {
+    WriteBack();
+    if (file_) {
+      std::fflush(file_);
+    }
+  }
+
+ private:
+  void WriteBack() {
+    if (mode_ != Mode::kReadWrite || !file_ || !data_) {
+      return;
+    }
+    if (rex::filesystem::Seek(file_, int64_t(offset_), SEEK_SET)) {
+      std::fwrite(data_, 1, size(), file_);
+    }
+  }
+
+  FILE* file_;
+  size_t offset_;
+  Mode mode_;
+};
+
+std::unique_ptr<MappedMemory> MappedMemory::Open(const std::filesystem::path& path, Mode mode,
+                                                 size_t offset, size_t length) {
+  FILE* file = rex::filesystem::OpenFile(path, mode == Mode::kRead ? "rb" : "r+b");
+  if (!file) {
+    return nullptr;
+  }
+  if (!length) {
+    if (!rex::filesystem::Seek(file, 0, SEEK_END)) {
+      std::fclose(file);
+      return nullptr;
+    }
+    const int64_t file_size = rex::filesystem::Tell(file);
+    if (file_size < int64_t(offset)) {
+      std::fclose(file);
+      return nullptr;
+    }
+    length = size_t(file_size) - offset;
+  }
+  // Page-aligned like a real mapping (callers may assume it).
+  void* data = std::aligned_alloc(0x1000, (length + 0xFFF) & ~size_t(0xFFF));
+  if (!data || !rex::filesystem::Seek(file, int64_t(offset), SEEK_SET) ||
+      std::fread(data, 1, length, file) != length) {
+    REXSYS_ERROR("switch2: MappedMemory::Open({}) could not read 0x{:X} bytes", path.string(),
+                 length);
+    std::free(data);
+    std::fclose(file);
+    return nullptr;
+  }
+  if (mode == Mode::kRead) {
+    std::fclose(file);
+    file = nullptr;
+  }
+  return std::make_unique<Switch2MappedMemory>(data, length, file, offset, mode);
+}
+
+std::unique_ptr<ChunkedMappedMemoryWriter> ChunkedMappedMemoryWriter::Open(
+    const std::filesystem::path& path, size_t chunk_size, bool low_address_space) {
+  (void)path;
+  (void)chunk_size;
+  (void)low_address_space;
+  return nullptr;
+}
+
+}  // namespace rex::memory
