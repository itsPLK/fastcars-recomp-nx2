diff --git a/src/audio/switch2/switch2_audio_system.cpp b/src/audio/switch2/switch2_audio_system.cpp
new file mode 100644
index 00000000..404785b9
--- /dev/null
+++ b/src/audio/switch2/switch2_audio_system.cpp
@@ -0,0 +1,271 @@
+// Switch 2 audio backend: audout (48 kHz, 2 ch, PCM s16).
+//
+// One guest frame (6 channels x 256 samples, big-endian float, channel-sequential) becomes one
+// audout buffer of 256 stereo s16 samples (1 KiB, in a 4 KiB-aligned page). A worker thread keeps
+// a few buffers queued on the device; each guest frame handed to the device releases the client
+// semaphore once, as the SDL backend's callback does, so the device clock paces the guest's audio
+// engine. When the guest is late the worker queues silence instead.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <switch.h>
+
+#include <rex/audio/audio_driver.h>
+#include <rex/audio/conversion.h>
+#include <rex/audio/downmix.h>
+#include <rex/audio/switch2/switch2_audio_system.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/thread.h>
+
+REXCVAR_DEFINE_INT32(audio_switch2_queued_buffers, 3, "Audio",
+                     "Switch 2: audout buffers kept queued on the device (5.3 ms each)");
+
+namespace rex::audio::switch2 {
+
+namespace {
+
+constexpr uint32_t kChannelSamples = 256;            // per guest frame, per channel
+constexpr uint32_t kGuestChannels = 6;
+constexpr uint32_t kGuestFrameSamples = kChannelSamples * kGuestChannels;
+constexpr uint32_t kSampleRate = 48000;
+constexpr uint32_t kOutChannels = 2;
+constexpr uint32_t kOutBytes = kChannelSamples * kOutChannels * sizeof(int16_t);  // 1 KiB
+constexpr uint32_t kBufferBytes = 0x1000;            // audout wants 4 KiB-aligned buffers
+constexpr int kMaxBuffers = 16;
+
+class Switch2AudioDriver final : public AudioDriver {
+ public:
+  Switch2AudioDriver(memory::Memory* memory, rex::thread::Semaphore* semaphore)
+      : AudioDriver(memory), semaphore_(semaphore) {
+    worker_ = std::thread([this] { Worker(); });
+  }
+
+  ~Switch2AudioDriver() override {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      running_ = false;
+    }
+    cv_.notify_all();
+    if (worker_.joinable()) worker_.join();
+    for (float* f : queued_) delete[] f;
+    for (float* f : spare_) delete[] f;
+  }
+
+  void SubmitFrame(uint32_t frame_ptr) override {
+    const float* in = memory_->TranslateVirtual<const float*>(frame_ptr);
+    float* copy;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (spare_.empty()) {
+        copy = new float[kGuestFrameSamples];
+      } else {
+        copy = spare_.back();
+        spare_.pop_back();
+      }
+    }
+    std::memcpy(copy, in, kGuestFrameSamples * sizeof(float));
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      queued_.push_back(copy);
+    }
+    cv_.notify_one();
+  }
+
+ private:
+  // Takes the next guest frame, or nullptr when none is queued.
+  float* TakeFrame() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (queued_.empty()) return nullptr;
+    float* f = queued_.front();
+    queued_.pop_front();
+    return f;
+  }
+
+  void Recycle(float* f) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    spare_.push_back(f);
+  }
+
+  bool Running() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return running_;
+  }
+
+  static void Fold(int16_t* out, const float* guest, const StereoFold& fold, float gain) {
+    float mix[kChannelSamples * kOutChannels];
+    conversion::sequential_6_BE_to_interleaved_2_LE(mix, guest, kChannelSamples, fold, gain);
+    for (uint32_t i = 0; i < kChannelSamples * kOutChannels; ++i) {
+      out[i] = static_cast<int16_t>(std::lrintf(std::clamp(mix[i], -1.0f, 1.0f) * 32767.0f));
+    }
+  }
+
+  bool StartDevice() {
+    Result rc = audoutInitialize();
+    if (R_FAILED(rc)) {
+      REXAPU_ERROR("audoutInitialize failed: 0x{:X}; running silent", rc);
+      return false;
+    }
+    rc = audoutStartAudioOut();
+    if (R_FAILED(rc)) {
+      REXAPU_ERROR("audoutStartAudioOut failed: 0x{:X}; running silent", rc);
+      audoutExit();
+      return false;
+    }
+    REXAPU_INFO("audout started: {} Hz, {} ch, format {}", audoutGetSampleRate(),
+                audoutGetChannelCount(), static_cast<int>(audoutGetPcmFormat()));
+    return true;
+  }
+
+  // No device: one guest frame per 5.3 ms is consumed and released, like the device would.
+  void SilentLoop() {
+    using Clock = std::chrono::steady_clock;
+    const auto period = std::chrono::nanoseconds(1000000000ll * kChannelSamples / kSampleRate);
+    auto next = Clock::now();
+    while (Running()) {
+      next += period;
+      auto now = Clock::now();
+      if (next < now - 4 * period) next = now;
+      if (next > now) std::this_thread::sleep_until(next);
+      if (float* f = TakeFrame()) {
+        Recycle(f);
+        semaphore_->Release(1, nullptr);
+      }
+    }
+  }
+
+  void Worker() {
+    if (!StartDevice()) {
+      SilentLoop();
+      return;
+    }
+
+    const int in_flight_max =
+        std::clamp(REXCVAR_GET(audio_switch2_queued_buffers), 2, kMaxBuffers);
+    std::vector<void*> pages;
+    std::vector<AudioOutBuffer> buffers(kMaxBuffers);
+    std::vector<AudioOutBuffer*> free_buffers;
+    for (int i = 0; i < kMaxBuffers; ++i) {
+      void* page = std::aligned_alloc(kBufferBytes, kBufferBytes);
+      std::memset(page, 0, kBufferBytes);
+      pages.push_back(page);
+      buffers[i] = {};
+      buffers[i].buffer = page;
+      buffers[i].buffer_size = kBufferBytes;
+      buffers[i].data_size = kOutBytes;
+      buffers[i].data_offset = 0;
+      free_buffers.push_back(&buffers[i]);
+    }
+
+    int in_flight = 0;
+    uint32_t stat_frames = 0, stat_silence = 0;
+    while (Running()) {
+      // Reclaim played buffers; block while the device queue is full.
+      for (;;) {
+        AudioOutBuffer* released = nullptr;
+        u32 count = 0;
+        Result rc;
+        if (in_flight >= in_flight_max) {
+          rc = audoutWaitPlayFinish(&released, &count, 100'000'000ull);  // 100 ms
+        } else {
+          rc = audoutGetReleasedAudioOutBuffer(&released, &count);
+        }
+        if (R_FAILED(rc) || count == 0 || !released) break;
+        free_buffers.push_back(released);
+        --in_flight;
+      }
+      if (in_flight >= in_flight_max || free_buffers.empty()) {
+        continue;  // wait timed out (device stalled, e.g. suspended): try again
+      }
+
+      AudioOutBuffer* buf = free_buffers.back();
+      free_buffers.pop_back();
+      auto* out = static_cast<int16_t*>(buf->buffer);
+      float* frame = TakeFrame();
+      if (!frame && in_flight > 0) {
+        // Guest a little late: give it up to half a frame before queuing silence.
+        std::unique_lock<std::mutex> lock(mutex_);
+        cv_.wait_for(lock, std::chrono::microseconds(2600),
+                     [this] { return !queued_.empty() || !running_; });
+        lock.unlock();
+        frame = TakeFrame();
+      }
+      if (frame) {
+        Fold(out, frame, GetStereoFold(), GetOutputGain());
+        Recycle(frame);
+      } else {
+        std::memset(out, 0, kOutBytes);
+        ++stat_silence;
+      }
+      armDCacheFlush(out, kOutBytes);
+      buf->data_size = kOutBytes;
+      Result rc = audoutAppendAudioOutBuffer(buf);
+      if (R_FAILED(rc)) {
+        REXAPU_ERROR("audoutAppendAudioOutBuffer failed: 0x{:X}", rc);
+        free_buffers.push_back(buf);
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+      } else {
+        ++in_flight;
+      }
+      if (frame) semaphore_->Release(1, nullptr);
+
+      if (++stat_frames >= 1875) {  // ~10 s
+        REXAPU_INFO("audio: {} of {} frames were silence (guest late)", stat_silence,
+                    stat_frames);
+        stat_frames = stat_silence = 0;
+      }
+    }
+
+    audoutStopAudioOut();
+    for (;;) {
+      AudioOutBuffer* released = nullptr;
+      u32 count = 0;
+      if (R_FAILED(audoutGetReleasedAudioOutBuffer(&released, &count)) || count == 0) break;
