+          p += reg.size();
+        }
+      }
+    }
+    // rewrite the macro names on this line
+    size_t pos = 0;
+    while (pos < l.size()) {
+      size_t hit = l.find("REX_", pos);
+      if (hit == std::string_view::npos) {
+        out.append(l.substr(pos));
+        break;
+      }
+      out.append(l.substr(pos, hit - pos));
+      bool isLoad = l.compare(hit, 10, "REX_LOAD_U") == 0;
+      bool isStore = l.compare(hit, 11, "REX_STORE_U") == 0;
+      if (isLoad || isStore) {
+        size_t open = l.find('(', hit);
+        bool stack = open != std::string_view::npos &&
+                     (l.compare(open, 15, "(ctx.r1.u32 + -") == 0 ||
+                      l.compare(open, 14, "(ctx.r1.u32 + ") == 0 ||
+                      l.compare(open, 13, "(ctx.r1.u32)") == 0);
+        out.append(isLoad ? "REX_LOAD_" : "REX_STORE_");
+        if (isLoad && depth > 0)
+          out.append("LOOP_");  // also a stack slot another thread may write: never hoisted
+        else if (stack)
