+/**
+ * @file        ui/windowed_app_context_switch2.h
+ * @brief       Switch 2 (Horizon, libounce) implementation of the windowed app UI loop context
+ *
+ * No SDL3 on Switch 2. The UI loop runs on the main thread and pumps the applet (appletMainLoop):
+ * a HOME-menu exit turns into the same close request SDL's quit event makes on desktop. Pending
+ * UI-thread functions wake the loop through a condition variable; between wakeups it polls the
+ * applet at about 60 Hz.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <mutex>
+#include <vector>
+
+#include <rex/ui/windowed_app_context.h>
+
+namespace rex::ui {
+
+class WindowSwitch2;
+
+class Switch2WindowedAppContext final : public WindowedAppContext {
+ public:
+  Switch2WindowedAppContext() = default;
+  ~Switch2WindowedAppContext() override;
+
+  bool Initialize();
+
+  void NotifyUILoopOfPendingFunctions() override;
+  void PlatformQuitFromUIThread() override;
+
+  int RunMainMessageLoop();
+
+  // Window registry (UI thread only) and coalesced paint requests (any thread).
+  void RegisterWindow(WindowSwitch2* window);
+  void UnregisterWindow(WindowSwitch2* window);
+  void RequestPaint();
+
+ private:
+  void ProcessQuitRequest();
+
+  std::vector<WindowSwitch2*> windows_;
+  std::mutex wake_mutex_;
+  std::condition_variable wake_cv_;
+  bool wake_pending_ = false;
+  std::atomic<bool> paint_pending_{false};
+};
+
+}  // namespace rex::ui
