diff --git a/src/core/exception_handler_switch2.cpp b/src/core/exception_handler_switch2.cpp
new file mode 100644
index 00000000..6e780acb
--- /dev/null
+++ b/src/core/exception_handler_switch2.cpp
@@ -0,0 +1,186 @@
+/**
+ * Switch 2 CPU exceptions (no signals on Horizon).
+ *
+ * libounce delivers every CPU exception of the process to __libnx_exception_handler, on the
+ * faulting thread, on the shared __nx_exception_stack. This file owns that hook:
+ *  1. handlers registered with ExceptionHandler::Install see the fault first, as on POSIX; if one
+ *     handles it, the thread resumes with the (possibly modified) context, except x16 (see
+ *     rex/platform/exception_switch2.h);
+ *  2. otherwise, inside an SEH region, the thread resumes at the SEH throw trampoline;
+ *  3. otherwise a crash report goes to stderr and sdmc:/switch/fastcars/crash.txt, and libounce ends
+ *     the process.
+ * Horizon gives no recoverable page faults for protection tricks (Protect is a no-op there), so
+ * nothing in the runtime should fault on purpose; this is for real bugs and guest SEH.
+ */
+#include <rex/exception_handler.h>
+#include <rex/platform.h>
+
+static_assert(REX_PLATFORM_SWITCH2, "Switch 2 only");
+
+#include <switch.h>
+
+#include <cstdio>
+#include <cstring>
+
+#include <rex/math.h>
+#include <rex/platform/exception_switch2.h>
+#include <rex/platform/exceptions.h>
+
+// One exception stack for the whole process (libounce's design): two threads faulting at the
+// same moment would share it. 64 KB leaves room for handlers that log.
+extern "C" {
+alignas(16) uint8_t __nx_exception_stack[0x10000];
+uint64_t __nx_exception_stack_size = sizeof(__nx_exception_stack);
+}
+
+namespace rex::platform::switch2 {
+bool seh_redirect(ResumeFrame* frame, uint32_t code, uintptr_t fault_address);
+}
+
+namespace rex::arch {
+
+using platform::switch2::ResumeFrame;
+
+namespace {
+
+constexpr size_t kMaxHandlerCount = 8;
+std::pair<ExceptionHandler::Handler, void*> handlers_[kMaxHandlerCount];
+
+void ToFrame(const ThreadExceptionDump& d, ResumeFrame* f) {
+  for (int i = 0; i < 29; i++) f->x[i] = d.cpu_gprs[i].x;
+  f->x[29] = d.fp.x;
+  f->x[30] = d.lr.x;
+  f->sp = d.sp.x;
+  f->pc = d.pc.x;
+  f->nzcv = d.pstate & 0xF0000000u;
+  uint64_t fpsr, fpcr;
+  __asm__ volatile("mrs %0, fpsr" : "=r"(fpsr));
+  __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+  f->fpsr = fpsr;
+  f->fpcr = fpcr;
+  for (int i = 0; i < 32; i++) std::memcpy(f->v[i], &d.fpu_gprs[i], 16);
+}
+
+void ToHostContext(const ResumeFrame& f, HostThreadContext* c) {
+  for (int i = 0; i < 31; i++) c->x[i] = f.x[i];
+  c->sp = f.sp;
+  c->pc = f.pc;
+  c->pstate = f.nzcv;
+  c->fpsr = uint32_t(f.fpsr);
+  c->fpcr = uint32_t(f.fpcr);
+  for (int i = 0; i < 32; i++) std::memcpy(&c->v[i], f.v[i], 16);
+}
+
+void FromHostContext(const HostThreadContext& c, ResumeFrame* f) {
+  for (int i = 0; i < 31; i++) f->x[i] = c.x[i];
+  f->sp = c.sp;
+  f->pc = c.pc;
+  f->nzcv = c.pstate & 0xF0000000u;
+  f->fpsr = c.fpsr;
+  f->fpcr = c.fpcr;
+  for (int i = 0; i < 32; i++) std::memcpy(f->v[i], &c.v[i], 16);
+}
+
+void ReportCrash(const ThreadExceptionDump& d) {
+  FILE* outputs[2] = {stderr, std::fopen("sdmc:/switch/fastcars/crash.txt", "a")};
+  for (FILE* out : outputs) {
+    if (!out) continue;
+    std::fprintf(out, "\n=== unhandled CPU exception desc=0x%x esr=0x%x far=0x%016llx ===\n",
+                 d.error_desc, d.esr, (unsigned long long)d.far.x);
+    std::fprintf(out, "pc %016llx lr %016llx sp %016llx fp %016llx\n", (unsigned long long)d.pc.x,
+                 (unsigned long long)d.lr.x, (unsigned long long)d.sp.x, (unsigned long long)d.fp.x);
+    for (int r = 0; r < 29; r += 4) {
+      std::fprintf(out, "x%-2d %016llx %016llx %016llx %016llx\n", r,
+                   (unsigned long long)d.cpu_gprs[r].x,
+                   (unsigned long long)(r + 1 < 29 ? d.cpu_gprs[r + 1].x : 0),
+                   (unsigned long long)(r + 2 < 29 ? d.cpu_gprs[r + 2].x : 0),
+                   (unsigned long long)(r + 3 < 29 ? d.cpu_gprs[r + 3].x : 0));
+    }
+    // Frame-pointer walk (addresses; symbolize with the ELF and addr2line).
+    uint64_t fp = d.fp.x;
+    for (int i = 0; i < 32 && fp && (fp & 7) == 0; i++) {
+      MemoryInfo info{};
+      u32 page_info = 0;
+      if (R_FAILED(svcQueryMemory(&info, &page_info, fp)) || !(info.perm & Perm_R)) break;
+      const uint64_t next = reinterpret_cast<const uint64_t*>(fp)[0];
+      const uint64_t ret = reinterpret_cast<const uint64_t*>(fp)[1];
+      if (!ret) break;
+      std::fprintf(out, "  frame %016llx\n", (unsigned long long)ret);
+      if (next <= fp) break;
+      fp = next;
+    }
+    std::fflush(out);
+    if (out != stderr) std::fclose(out);
+  }
+}
+
+}  // namespace
+
+void ExceptionHandler::Install(Handler fn, void* data) {
+  for (size_t i = 0; i < rex::countof(handlers_); ++i) {
+    if (!handlers_[i].first) {
+      handlers_[i].first = fn;
+      handlers_[i].second = data;
+      return;
+    }
+  }
+  assert_always("Too many exception handlers installed");
+}
+
+void ExceptionHandler::Uninstall(Handler fn, void* data) {
+  for (size_t i = 0; i < rex::countof(handlers_); ++i) {
+    if (handlers_[i].first == fn && handlers_[i].second == data) {
+      for (; i < rex::countof(handlers_) - 1; ++i) {
+        handlers_[i] = handlers_[i + 1];
+      }
+      handlers_[i].first = nullptr;
+      handlers_[i].second = nullptr;
+      return;
+    }
+  }
+}
+
+}  // namespace rex::arch
+
+extern "C" void __libnx_exception_handler(ThreadExceptionDump* dump) {
+  using namespace rex::arch;
+  using rex::SehException;
+  using rex::countof;
+  namespace platform = rex::platform;
+  ResumeFrame frame;
+  ToFrame(*dump, &frame);
+
+  // ESR exception class: 0x24/0x25 data abort (bit 6 = write), 0x20/0x21 instruction abort,
+  // 0x00 undefined instruction.
+  const uint32_t ec = (dump->esr >> 26) & 0x3F;
+  const bool data_abort = ec == 0x24 || ec == 0x25;
+  const bool instruction_abort = ec == 0x20 || ec == 0x21;
+
+  HostThreadContext thread_context;
+  ToHostContext(frame, &thread_context);
+  Exception ex;
+  if (data_abort || instruction_abort) {
+    ex.InitializeAccessViolation(&thread_context, dump->far.x,
+                                 data_abort ? ((dump->esr & (1u << 6))
+                                                   ? Exception::AccessViolationOperation::kWrite
+                                                   : Exception::AccessViolationOperation::kRead)
+                                            : Exception::AccessViolationOperation::kUnknown);
+  } else {
+    ex.InitializeIllegalInstruction(&thread_context);
+  }
+
+  for (size_t i = 0; i < countof(handlers_) && handlers_[i].first; ++i) {
+    if (handlers_[i].first(&ex, handlers_[i].second)) {
+      FromHostContext(thread_context, &frame);
+      rex_switch2_resume(&frame);
+    }
+  }
+
+  const uint32_t seh_code = (data_abort || instruction_abort)
+                                ? SehException::ACCESS_VIOLATION
+                                : SehException::ILLEGAL_INSTRUCTION;
+  platform::switch2::seh_redirect(&frame, seh_code, dump->far.x);  // returns only outside SEH
+
+  ReportCrash(*dump);
+  // Returning lets libounce end the process (svcBreak).
+}
