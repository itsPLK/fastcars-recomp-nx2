--- /dev/null
+++ b/src/core/alias_audit.cpp
@@ -0,0 +1,232 @@
+// See rex/memory/alias_audit.h.
+#include <rex/memory/alias_audit.h>
+
+#include <rex/platform.h>
+
+#if !REX_PLATFORM_WIN32 && !REX_PLATFORM_SWITCH2
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <map>
+#include <string>
+
+#include <atomic>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+#include <rex/logging.h>
+
+namespace rex::memory::alias_audit {
+
+namespace {
+
+constexpr size_t kMaxWindows = 4;
+constexpr size_t kPhysicalSize = 0x20000000;  // 512 MB of guest physical memory
+
+struct Window {
+  uint8_t* base;
+  size_t size;
+  const char* name;
+  uint32_t guest_base;
+};
+
+Window g_windows[kMaxWindows];
+std::atomic<size_t> g_window_count{0};
+size_t g_page = 0;
+// Per physical host page: bit n = touched through window n.
+std::atomic<uint8_t>* g_touched = nullptr;
+std::atomic<uint64_t> g_first_touches{0};
+std::atomic<uint64_t> g_alias_pages{0};
+std::atomic<uint64_t> g_window_touches[kMaxWindows] = {};
+// Per window and page: the protection the runtime last asked for (applied on first touch).
+uint8_t* g_requested[kMaxWindows] = {};
+thread_local uint64_t t_fault_pc = 0;
+// Alias events per "module+thread" (who made the second-window access).
+std::map<std::string, uint64_t> g_alias_by_source;
+
+std::string DescribePc(uint64_t pc) {
+  Dl_info info{};
+  if (pc && dladdr(reinterpret_cast<void*>(pc), &info) && info.dli_fname) {
+    const char* slash = std::strrchr(info.dli_fname, '/');
+    char buf[256];
+    std::snprintf(buf, sizeof(buf), "%s+0x%llx", slash ? slash + 1 : info.dli_fname,
+                  (unsigned long long)(pc - uint64_t(info.dli_fbase)));
+    return buf;
+  }
+  return "?";
+}
+
+std::string ModuleOf(uint64_t pc) {
+  Dl_info info{};
+  if (pc && dladdr(reinterpret_cast<void*>(pc), &info) && info.dli_fname) {
+    const char* slash = std::strrchr(info.dli_fname, '/');
+    return slash ? slash + 1 : info.dli_fname;
+  }
+  return "?";
+}
+
+std::string ThreadName() {
+  char name[64] = {};
+  pthread_getname_np(pthread_self(), name, sizeof(name));
+  return name[0] ? name : "unnamed";
+}
+
+int ToProt(uint8_t requested) {
+  return requested;  // stored as PROT_* bits
+}
+std::mutex g_log_mutex;
+
+const Window* FindWindow(uintptr_t address, size_t* out_index) {
+  const size_t count = g_window_count.load(std::memory_order_acquire);
+  for (size_t i = 0; i < count; i++) {
+    const uintptr_t base = reinterpret_cast<uintptr_t>(g_windows[i].base);
+    if (address >= base && address < base + g_windows[i].size) {
+      *out_index = i;
+      return &g_windows[i];
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+bool Enabled() {
+  static const bool enabled = [] {
+    const char* v = std::getenv("REX_ALIAS_AUDIT");
+    return v && v[0] == '1';
+  }();
+  return enabled;
+}
+
+void RegisterWindow(uint8_t* view_base, size_t size, const char* name, uint32_t guest_base) {
+  if (!Enabled()) return;
+  if (!g_touched) {
+    g_page = size_t(getpagesize());
+    const size_t pages = kPhysicalSize / g_page;
+    g_touched = new std::atomic<uint8_t>[pages];
+    for (size_t i = 0; i < pages; i++) g_touched[i].store(0, std::memory_order_relaxed);
+  }
+  const size_t index = g_window_count.load();
+  if (index >= kMaxWindows) return;
+  g_windows[index] = {view_base, size, name, guest_base};
+  const size_t window_pages = size / g_page;
+  g_requested[index] = new uint8_t[window_pages];
+  std::memset(g_requested[index], PROT_READ | PROT_WRITE, window_pages);
+  g_window_count.store(index + 1, std::memory_order_release);
+  mprotect(view_base, size, PROT_NONE);
+  REXSYS_WARN("[alias-audit] window {} guest 0x{:08X} host {} size 0x{:X} protected", name,
+              guest_base, static_cast<void*>(view_base), size);
+}
+
+bool OnFault(void* host_address, bool is_write) {
+  if (!Enabled() || !g_touched) return false;
+  const uintptr_t address = reinterpret_cast<uintptr_t>(host_address);
+  size_t window_index = 0;
+  const Window* window = FindWindow(address, &window_index);
+  if (!window) return false;
+  const size_t offset = address - reinterpret_cast<uintptr_t>(window->base);
+  const size_t page = offset / g_page;
+  if (page >= kPhysicalSize / g_page) return false;
+  const uint8_t bit = uint8_t(1u << window_index);
+  const uint8_t before = g_touched[page].fetch_or(bit);
+  if (before & bit) {
+    return false;  // already opened: a protection the runtime set itself
+  }
+  // Open the page with the protection the runtime asked for. If that protection forbids this
+  // access (a page the runtime watches), the runtime's own handling runs next.
+  const uint8_t requested = g_requested[window_index][page];
+  mprotect(window->base + page * g_page, g_page, ToProt(requested));
+  const bool allowed = is_write ? (requested & PROT_WRITE) : (requested & PROT_READ);
+  const uint64_t touches = ++g_first_touches;
+  if (before) {
+    const uint64_t aliases = ++g_alias_pages;
+    std::lock_guard lock(g_log_mutex);
+    const std::string source = ModuleOf(t_fault_pc) + " / " + ThreadName();
+    const uint64_t from_source = ++g_alias_by_source[source];
+    if (from_source <= 3 || (aliases % 500) == 0) {
+      std::string summary;
+      for (const auto& [src, n] : g_alias_by_source) summary += " [" + src + ": " + std::to_string(n) + "]";
+      REXSYS_WARN("[alias-audit] alias sources so far:{}", summary);
+    }
+    if (aliases <= 200 || (aliases % 1000) == 0) {
+      std::string seen;
+      for (size_t i = 0; i < g_window_count.load(); i++) {
+        if (before & (1u << i)) {
+          seen += g_windows[i].name;
+        }
+      }
+      REXSYS_WARN(
+          "[alias-audit] ALIAS #{}: physical 0x{:08X} {} through window {} (guest 0x{:08X}), "
+          "already seen through {}; pc {} thread {}",
+          aliases, uint32_t(page * g_page), is_write ? "write" : "read", window->name,
+          uint32_t(window->guest_base + offset), seen, DescribePc(t_fault_pc), ThreadName());
+    }
+  }
+  ++g_window_touches[window_index];
+  if (touches == 1 || touches == 10 || touches == 100 || touches == 1000 ||
+      (touches % 5000) == 0) {
+    REXSYS_WARN(
+        "[alias-audit] {} first touches (A {} C {} E {} 7F {}), {} pages seen through 2+ windows",
+        touches, g_window_touches[0].load(), g_window_touches[1].load(),
+        g_window_touches[2].load(), g_window_touches[3].load(), g_alias_pages.load());
+  }
+  return allowed;
+}
+
+void SetFaultPc(uint64_t pc) {
+  t_fault_pc = pc;
+}
+
+bool FilterProtect(void* base_address, size_t length, PageAccess access) {
+  if (!Enabled() || !g_touched || !length) return false;
+  const uintptr_t start = reinterpret_cast<uintptr_t>(base_address);
+  size_t window_index = 0;
+  const Window* window = FindWindow(start, &window_index);
+  if (!window) return false;
+  const uintptr_t window_base = reinterpret_cast<uintptr_t>(window->base);
+  const uintptr_t end = std::min<uintptr_t>(start + length, window_base + window->size);
+  int prot = PROT_NONE;
+  if (access == PageAccess::kReadOnly || access == PageAccess::kExecuteReadOnly) prot = PROT_READ;
+  if (access == PageAccess::kReadWrite || access == PageAccess::kExecuteReadWrite)
+    prot = PROT_READ | PROT_WRITE;
+  const uint8_t bit = uint8_t(1u << window_index);
+  for (uintptr_t page_start = start & ~(g_page - 1); page_start < end; page_start += g_page) {
+    const size_t page = (page_start - window_base) / g_page;
+    g_requested[window_index][page] = uint8_t(prot);
+    if (g_touched[page].load() & bit) {
+      mprotect(reinterpret_cast<void*>(page_start), g_page, prot);
+    }
+  }
+  return true;
+}
+
+void TouchRange(void* buffer, size_t length) {
+  if (!Enabled() || !g_touched || !length) return;
+  const uintptr_t start = reinterpret_cast<uintptr_t>(buffer);
+  size_t window_index = 0;
+  if (!FindWindow(start, &window_index) && !FindWindow(start + length - 1, &window_index)) return;
+  for (uintptr_t p = start & ~(g_page - 1); p < start + length; p += g_page) {
+    const uintptr_t touch = std::max(p, start);
+    (void)*reinterpret_cast<volatile const uint8_t*>(touch);
+  }
+}
+
+}  // namespace rex::memory::alias_audit
+
+#else  // Windows, Switch 2: no audit.
+
+namespace rex::memory::alias_audit {
+bool Enabled() { return false; }
+void SetFaultPc(uint64_t) {}
+void RegisterWindow(uint8_t*, size_t, const char*, uint32_t) {}
+bool OnFault(void*, bool) { return false; }
+bool FilterProtect(void*, size_t, PageAccess) { return false; }
+void TouchRange(void*, size_t) {}
+}  // namespace rex::memory::alias_audit
+
+#endif
