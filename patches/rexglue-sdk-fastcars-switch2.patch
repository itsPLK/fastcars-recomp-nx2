+        pos = hit + (isLoad ? 9 : 10);
+      } else {
+        out.append("REX_");
+        pos = hit + 4;
+      }
+    }
+    out += '\n';
+  }
+  if (!body.empty() && body.back() != '\n' && !out.empty())
+    out.pop_back();
+  body.swap(out);
+}
