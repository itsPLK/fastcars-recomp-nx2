diff --git a/libavcodec/wmaprodec.c b/libavcodec/wmaprodec.c
--- a/libavcodec/wmaprodec.c
+++ b/libavcodec/wmaprodec.c
@@ -2051,6 +2051,28 @@
     int ret, xma_frame_len = 0;
     uint8_t padding_start, padding_end = 0;

+    if (!avpkt->size) {
+        int ch;
+
+        *got_frame_ptr = 0;
+        if (!s->frame_num || s->eof_done) {
+            return 0;
+        }
+
+        /* The last IMDCT left half a frame in the overlap buffer. */
+        frame->nb_samples = s->samples_per_frame / 2;
+        if ((ret = ff_get_buffer(avctx, frame, 0)) < 0) {
+            return ret;
+        }
+        for (ch = 0; ch < s->nb_channels; ch++) {
+            memcpy(frame->extended_data[ch], s->channel[ch].out,
+                   frame->nb_samples * sizeof(*s->channel[ch].out));
+        }
+        s->eof_done = 1;
+        *got_frame_ptr = 1;
+        return 0;
+    }
+
     if (avpkt->size < 3) {
       av_log(avctx, AV_LOG_ERROR, "XMA Frame is to small, %d bytes\n", avpkt->size);
       return AVERROR_INVALIDDATA;
@@ -2152,7 +2174,7 @@
     .init           = xmaframes_decode_init,
     .close          = xmaframes_decode_end,
     .decode         = xmaframes_decode_packet,
-    .capabilities   = AV_CODEC_CAP_DR1,
+    .capabilities   = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_DELAY,
     .caps_internal  = FF_CODEC_CAP_INIT_CLEANUP,
     .sample_fmts    = (const enum AVSampleFormat[]) { AV_SAMPLE_FMT_FLTP,
                                                       AV_SAMPLE_FMT_NONE },
