+bool XmaContext::DrainFinalFrame(const XMA_CONTEXT_DATA& data) {
+  // Buffer exhaustion clears the valid bits. The guest explicitly detaches both
+  // inputs when it wants the final PCM, so preserve the carry across refills.
+  if (!carry_valid_ || data.IsAnyInputBufferValid() || data.input_buffer_0_ptr ||
+      data.input_buffer_1_ptr || data.loop_count || data.error_status ||
+      av_context_->channels != (data.is_stereo ? 2 : 1) ||
+      av_context_->sample_rate != GetSampleRate(data.sample_rate)) {
+    return false;
+  }
+
+  const bool decoded = DecodePacket(av_context_, nullptr, av_frame_);
+  // Sending EOF closes this codec stream. PrepareDecoder opens a fresh one
+  // on the next input, even if the guest reuses the context and format.
+  av_context_->sample_rate = 0;
+  av_context_->channels = 0;
+  carry_valid_ = false;
+  if (!decoded || av_frame_->nb_samples < static_cast<int>(kDecoderStartPadding)) {
+    return false;
+  }
+  ConvertFrame(reinterpret_cast<const uint8_t**>(&av_frame_->data), data.is_stereo,
+               decoded_frame_.data(), kDecoderStartPadding);
+  QueueAlignedFrame(data.is_stereo);
+  return current_frame_remaining_subframes_ != 0;
+}
+
+void XmaContext::QueueAlignedFrame(bool stereo) {
+  const size_t pad_bytes = kDecoderStartPadding * kBytesPerSample << stereo;
+  const size_t carry_bytes = (kBytesPerFrameChannel << stereo) - pad_bytes;
+  std::memcpy(raw_frame_.data(), carry_frame_.data(), carry_bytes);
+  std::memcpy(raw_frame_.data() + carry_bytes, decoded_frame_.data(), pad_bytes);
+  current_frame_remaining_subframes_ = 4 << stereo;
+  loop_frame_output_limit_ = pending_output_limit_;
+  current_frame_remaining_subframes_ -=
+      std::min(pending_start_skip_, current_frame_remaining_subframes_);
 }

